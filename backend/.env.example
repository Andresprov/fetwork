# Conexion pooled (runtime, via @prisma/adapter-pg).
DATABASE_URL="postgresql://user:password@host-pooler:5432/fetwork?sslmode=require"
# Conexion directa/sin pooler (usada por `prisma migrate`).
DIRECT_URL="postgresql://user:password@host:5432/fetwork?sslmode=require"

JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=3000

MODULE_USUARIOS_ENABLED=true
MODULE_EMPRESAS_ENABLED=true
MODULE_PERFILES_ENABLED=true
MODULE_PROYECTOS_ENABLED=true
MODULE_ADMINISTRACION_ENABLED=true

# Ruta a soffice (LibreOffice) para generar la hoja de vida en PDF. Opcional:
# por defecto usa la instalacion estandar de Windows/macOS o `soffice` del PATH.
# LIBREOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe"

# URL publica del backend: se antepone a los archivos subidos (foto de perfil)
# cuando se usa el almacenamiento local. Por defecto http://localhost:PORT.
# PUBLIC_URL="https://fetwork-api.onrender.com"

# Almacenamiento de archivos (foto de perfil y hoja de vida en PDF):
# "local" (por defecto, disco del backend en uploads/) o "cloudinary"
# (produccion: en Render/Railway el disco se borra en cada despliegue).
# ALMACENAMIENTO="cloudinary"
# Credenciales tal como las muestra el panel de Cloudinary (API Environment variable).
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Token personal de GitHub (sin permisos) para sincronizar repositorios.
# Opcional: sin token GitHub permite 60 consultas por hora por IP; con token, 5000.
# GITHUB_TOKEN="github_pat_..."
